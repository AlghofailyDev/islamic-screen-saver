<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>IslamicScreensaver</AssemblyName>
    <RootNamespace>IslamicScreensaver</RootNamespace>
    <!-- English only; keeps the publish folder free of ~20 satellite-resource directories. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Pre-compiled native code cuts cold-start noticeably, which is the whole game for a screensaver. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- WPF0001: Window.ThemeMode (the built-in Fluent theme) is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IslamicScreensaver.Core\IslamicScreensaver.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

  <!-- Shipped alongside the binary: the isti'ādhah recording, and any Quran font the user drops in. -->
  <ItemGroup>
    <Content Include="..\..\assets\audio\**\*" Link="assets\audio\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\**\*" Link="assets\fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Windows recognises a screensaver by its .scr extension. The .NET apphost locates its DLL and
    runtimeconfig by its own file name minus extension, so renaming the published exe is all it takes.
  -->
  <Target Name="RenameToScr" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)$(AssemblyName).scr" />
    <Delete Files="$(PublishDir)$(AssemblyName).exe" />
  </Target>

</Project>
