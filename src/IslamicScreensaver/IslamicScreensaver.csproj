<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>IslamicScreensaver</AssemblyName>
    <RootNamespace>IslamicScreensaver</RootNamespace>
    <!-- English only; keeps the publish folder free of ~20 satellite-resource directories. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Pre-compiled native code cuts cold-start noticeably, which is the whole game for a screensaver. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- WPF0001: Window.ThemeMode (the built-in Fluent theme) is still flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\IslamicScreensaver.Core\IslamicScreensaver.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

  <!--
    Shipped alongside the binary: the isti'ādhah recording, any Quran font the user drops in, and the
    catalog of reciters, so a fresh install has the full list before it has spoken to anything.
  -->
  <ItemGroup>
    <Content Include="..\..\assets\audio\**\*" Link="assets\audio\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\fonts\**\*" Link="assets\fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\catalog\**\*" Link="assets\catalog\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The licence and every third-party notice travel with each copy: the GPL asks for its text to
    accompany the program, and the MIT licences of the bundled .NET runtime and NAudio require their
    notices "in all copies". A self-contained build ships the runtime without them, so they are added here.
  -->
  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Windows recognises a screensaver by its .scr extension. The .NET apphost locates its DLL and
    runtimeconfig by its own file name minus extension, so renaming the published exe is all it takes.
  -->
  <Target Name="RenameToScr" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)$(AssemblyName).scr" />
    <Delete Files="$(PublishDir)$(AssemblyName).exe" />
  </Target>

</Project>
