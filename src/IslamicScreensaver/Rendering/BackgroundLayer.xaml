<UserControl x:Class="IslamicScreensaver.Rendering.BackgroundLayer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True"
             Background="Black">
    <Grid>
        <!-- Everything that drifts (Ken Burns) lives in here; the vignette stays fixed on top. -->
        <Grid x:Name="Drift" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="DriftScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Grid x:Name="Procedural" />
            <Image x:Name="Photo" Stretch="UniformToFill" Visibility="Collapsed" />
            <MediaElement x:Name="Video"
                          Stretch="UniformToFill"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Manual"
                          IsMuted="True"
                          Visibility="Collapsed" />
        </Grid>
        <Rectangle x:Name="Vignette" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.78" RadiusY="0.78">
                    <GradientStop Color="#00000000" Offset="0.45" />
                    <GradientStop Color="#73000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
