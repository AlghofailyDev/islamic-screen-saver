<UserControl x:Class="IslamicScreensaver.Settings.Pages.TranslationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IslamicScreensaver.Settings.Controls"
             xmlns:s="clr-namespace:IslamicScreensaver.Settings">
    <StackPanel MinWidth="740" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="{s:Loc translation.title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{s:Loc translation.subtitle}" Style="{StaticResource PageSubtitle}" />

        <c:SettingsCard Header="{s:Loc translation.show}" Margin="0,20,0,4">
            <ToggleButton x:Name="Show" Style="{StaticResource ToggleSwitch}" Click="Show_Click" />
        </c:SettingsCard>
        <c:SettingsCard Header="{s:Loc translation.language}">
            <ComboBox x:Name="LanguageBox" Width="220" Height="32" SelectionChanged="Language_Changed" />
        </c:SettingsCard>
        <c:SettingsCard Header="{s:Loc translation.which}" Description="{s:Loc translation.which.desc}">
            <ComboBox x:Name="Translation" Width="320" Height="32" SelectionChanged="Translation_Changed" />
        </c:SettingsCard>

        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,14" Margin="0,0,0,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Style="{StaticResource Body}" />
                    <TextBlock x:Name="StatusDetail" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    <ProgressBar x:Name="Progress" Maximum="1" Height="3" Margin="0,8,0,0" BorderThickness="0" Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="DownloadButton" Grid.Column="1" Content="{s:Loc common.download}" Style="{StaticResource AccentButton}" VerticalAlignment="Center" Margin="16,0,0,0" Click="Download_Click" />
            </Grid>
        </Border>

        <TextBlock x:Name="EmptyText" Text="The translation list has not been fetched yet — connect to the internet and use Refresh list on the Reciters page." Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
