<UserControl x:Class="IslamicScreensaver.Settings.Pages.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IslamicScreensaver.Settings.Controls">
    <StackPanel MinWidth="740" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="Audio" Style="{StaticResource PageTitle}" />
        <TextBlock Text="How loud the recitation is, where it plays, and how closely the text follows it." Style="{StaticResource PageSubtitle}" />

        <TextBlock Text="Output" Style="{StaticResource SectionTitle}" />
        <c:SettingsCard Header="Play through" Description="Leave on System default to follow Windows, or pick the speakers you want the screensaver to use">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="Device" Width="280" Height="32" DisplayMemberPath="Name" SelectionChanged="Device_Changed" />
                <Button Content="Refresh" Style="{StaticResource StandardButton}" Margin="8,0,0,0" Click="Refresh_Click" ToolTip="Look for devices again" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="Test" Description="Plays a few seconds of a downloaded surah through the chosen device">
            <Button x:Name="TestButton" Style="{StaticResource StandardButton}" Click="Test_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TestGlyph" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock x:Name="TestLabel" Text="Test" Style="{StaticResource Body}" />
                </StackPanel>
            </Button>
        </c:SettingsCard>
        <TextBlock x:Name="DeviceNote" Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="Collapsed" />

        <TextBlock Text="Playback" Style="{StaticResource SectionTitle}" />
        <c:SettingsCard Header="Volume">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="Volume" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" ValueChanged="Volume_Changed" />
                <TextBlock x:Name="VolumeValue" Style="{StaticResource SliderValue}" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="Text timing" Description="Nudge the verse text later (+) or earlier (−) if it does not match a reciter">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="SyncOffset" Style="{StaticResource SettingSlider}" Minimum="-2000" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="SyncOffset_Changed" />
                <TextBlock x:Name="SyncOffsetValue" Style="{StaticResource SliderValue}" Width="64" />
            </StackPanel>
        </c:SettingsCard>
    </StackPanel>
</UserControl>
