<UserControl x:Class="IslamicScreensaver.Settings.Pages.AudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IslamicScreensaver.Settings.Controls"
             xmlns:s="clr-namespace:IslamicScreensaver.Settings">
    <StackPanel MinWidth="740" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="{s:Loc audio.title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{s:Loc audio.subtitle}" Style="{StaticResource PageSubtitle}" />

        <TextBlock Text="{s:Loc audio.output}" Style="{StaticResource SectionTitle}" />
        <c:SettingsCard Header="{s:Loc audio.playThrough}" Description="{s:Loc audio.playThrough.desc}">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="Device" Width="280" Height="32" DisplayMemberPath="Name" SelectionChanged="Device_Changed" />
                <Button Content="{s:Loc common.refresh}" Style="{StaticResource StandardButton}" Margin="8,0,0,0" Click="Refresh_Click" ToolTip="Look for devices again" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="{s:Loc common.test}" Description="{s:Loc audio.test.desc}">
            <Button x:Name="TestButton" Style="{StaticResource StandardButton}" Click="Test_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TestGlyph" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock x:Name="TestLabel" Text="{s:Loc common.test}" Style="{StaticResource Body}" />
                </StackPanel>
            </Button>
        </c:SettingsCard>
        <TextBlock x:Name="DeviceNote" Style="{StaticResource Caption}" Margin="0,4,0,0" Visibility="Collapsed" />

        <TextBlock Text="{s:Loc audio.playback}" Style="{StaticResource SectionTitle}" />
        <c:SettingsCard Header="{s:Loc audio.volume}">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="Volume" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" ValueChanged="Volume_Changed" />
                <TextBlock x:Name="VolumeValue" Style="{StaticResource SliderValue}" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="{s:Loc audio.timing}" Description="{s:Loc audio.timing.desc}">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="SyncOffset" Style="{StaticResource SettingSlider}" Minimum="-2000" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="SyncOffset_Changed" />
                <TextBlock x:Name="SyncOffsetValue" Style="{StaticResource SliderValue}" Width="64" />
            </StackPanel>
        </c:SettingsCard>
    </StackPanel>
</UserControl>
