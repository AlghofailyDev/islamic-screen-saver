<UserControl x:Class="IslamicScreensaver.Settings.Pages.RecitersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IslamicScreensaver.Settings.Controls"
             xmlns:s="clr-namespace:IslamicScreensaver.Settings"
             xmlns:pages="clr-namespace:IslamicScreensaver.Settings.Pages">
    <StackPanel MinWidth="740" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="{s:Loc reciters.title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{s:Loc reciters.subtitle}" Style="{StaticResource PageSubtitle}" />

        <c:SettingsCard Header="{s:Loc library.rotate}" Description="{s:Loc library.rotate.desc}" Margin="0,20,0,4">
            <ToggleButton x:Name="Rotate" Style="{StaticResource ToggleSwitch}" Click="Rotate_Click" />
        </c:SettingsCard>

        <Grid Margin="0,16,0,10">
            <StackPanel Orientation="Horizontal">
                <Border Width="260" Height="32" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="10,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                        <TextBox x:Name="Search" Background="Transparent" BorderThickness="0" Padding="30,0,8,0" VerticalContentAlignment="Center" FontSize="14" TextChanged="Search_Changed" />
                        <TextBlock x:Name="SearchHint" Text="{s:Loc reciters.search}" Style="{StaticResource Body}" Foreground="{DynamicResource TextDisabledBrush}" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <TextBlock x:Name="CountText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
            <Button Content="{s:Loc reciters.refresh}" Style="{StaticResource StandardButton}" HorizontalAlignment="Right" Click="Refresh_Click" />
        </Grid>

        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
            <ItemsControl x:Name="List">
                <!-- Collapse the generated container, not just its content, so filtered-out rows leave no gap. -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:ReciterRow}">
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,0" MinHeight="64" Background="Transparent"
                                MouseLeftButtonUp="Row_Click" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- A speaker mark, not a checkbox: what plays is chosen per recitation inside. -->
                                <TextBlock Text="&#xE767;" Style="{StaticResource Icon}" FontSize="13" VerticalAlignment="Center" Width="16"
                                           Foreground="{DynamicResource AccentBrush}" ToolTip="{s:Loc recitation.playing}"
                                           Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />

                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="{Binding AvatarBrush}" Margin="16,0,0,0">
                                    <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding AvatarForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,10,16,10">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="170" HorizontalAlignment="Right">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0"
                                               Visibility="{Binding HasDownloads, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
                                </StackPanel>

                                <Button Grid.Column="4" Content="&#xE76C;" Style="{StaticResource IconButton}" VerticalAlignment="Center"
                                        Command="{Binding OpenCommand}" ToolTip="{s:Loc recitation.choose}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBlock x:Name="EmptyText" Text="{s:Loc reciters.empty}" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed" />

        <TextBlock x:Name="StorageText" Style="{StaticResource PathText}" Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
