<UserControl x:Class="IslamicScreensaver.Settings.Pages.RecitersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IslamicScreensaver.Settings.Controls"
             xmlns:pages="clr-namespace:IslamicScreensaver.Settings.Pages">
    <StackPanel MinWidth="740" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="Reciters" Style="{StaticResource PageTitle}" />
        <TextBlock Text="Choose who you hear. Tick more than one to take turns." Style="{StaticResource PageSubtitle}" />

        <c:SettingsCard Header="Rotate reciters" Description="Each ticked reciter takes one surah in turn" Margin="0,20,0,4">
            <ToggleButton x:Name="Rotate" Style="{StaticResource ToggleSwitch}" Click="Rotate_Click" />
        </c:SettingsCard>

        <Grid Margin="0,16,0,8">
            <TextBlock Text="Available reciters" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock x:Name="ScopeText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Content="Refresh list" Style="{StaticResource StandardButton}" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:ReciterRow}">
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,0" MinHeight="64">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />

                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="{Binding AvatarBrush}" Margin="16,0,0,0">
                                    <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding AvatarForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,10,16,10">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="170">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{StaticResource SuccessBrush}" Margin="0,0,6,0"
                                                   Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3" Margin="0,6,0,0" BorderThickness="0"
                                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding DownloadLabel}" Style="{StaticResource StandardButton}" Command="{Binding DownloadCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding ShowDownload, Converter={StaticResource BoolToVisibility}}" />
                                    <Button Content="{Binding PlayGlyph}" Style="{StaticResource IconButton}" Command="{Binding PlayCommand}" ToolTip="Listen to a cached surah" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <TextBlock x:Name="EmptyText" Text="The reciter list has not been fetched yet — connect to the internet and click Refresh list." Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="Collapsed" />

        <TextBlock Text="Playback" Style="{StaticResource SectionTitle}" />
        <c:SettingsCard Header="Volume">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="Volume" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" ValueChanged="Volume_Changed" />
                <TextBlock x:Name="VolumeValue" Style="{StaticResource SliderValue}" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="Text timing" Description="Nudge the verse text later (+) or earlier (−) if it does not match a reciter">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="SyncOffset" Style="{StaticResource SettingSlider}" Minimum="-2000" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="SyncOffset_Changed" />
                <TextBlock x:Name="SyncOffsetValue" Style="{StaticResource SliderValue}" Width="64" />
            </StackPanel>
        </c:SettingsCard>

        <TextBlock x:Name="StorageText" Style="{StaticResource Caption}" Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
