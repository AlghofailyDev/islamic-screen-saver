<UserControl x:Class="IslamicScreensaver.Settings.Pages.RecitationSurahsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:IslamicScreensaver.Settings"
             xmlns:pages="clr-namespace:IslamicScreensaver.Settings.Pages">
    <StackPanel MinWidth="740" MaxWidth="820" HorizontalAlignment="Left">

        <Button Style="{StaticResource StandardButton}" HorizontalAlignment="Left" BorderThickness="0" Background="Transparent" Padding="4,0,10,0" Click="Back_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                <TextBlock x:Name="BackLabel" Style="{StaticResource Body}" />
            </StackPanel>
        </Button>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                <TextBlock x:Name="Initials" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                <TextBlock x:Name="Title" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}" Margin="0,2,0,0" />
            </StackPanel>
            <Button x:Name="ListenButton" Grid.Column="2" Style="{StaticResource StandardButton}" VerticalAlignment="Center" Click="Listen_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ListenGlyph" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="{s:Loc common.listen}" Style="{StaticResource Body}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Action bar -->
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,14" Margin="0,20,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" Style="{StaticResource Body}" />
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="DeleteButton" Content="{s:Loc reciters.deleteSelected}" Style="{StaticResource StandardButton}" Margin="0,0,8,0" Click="Delete_Click" />
                        <Button x:Name="DownloadButton" Content="{s:Loc reciters.downloadSelected}" Style="{StaticResource AccentButton}" Click="Download_Click" />
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="Progress" Maximum="1" Height="3" Margin="0,12,0,0" BorderThickness="0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Selection tools -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,10">
            <Border Width="220" Height="32" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                <Grid>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="10,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                    <TextBox x:Name="Search" Background="Transparent" BorderThickness="0" Padding="30,0,8,0" VerticalContentAlignment="Center" FontSize="14" TextChanged="Search_Changed" />
                    <TextBlock x:Name="SearchHint" Text="{s:Loc reciters.searchSurahs}" Style="{StaticResource Body}" Foreground="{DynamicResource TextDisabledBrush}" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <Button Content="{s:Loc common.selectAll}" Style="{StaticResource StandardButton}" Margin="12,0,0,0" Click="SelectAll_Click" />
            <Button Content="{s:Loc reciters.selectMissing}" Style="{StaticResource StandardButton}" Margin="8,0,0,0" Click="SelectMissing_Click" ToolTip="Select every surah not downloaded yet" />
            <Button Content="{s:Loc common.clear}" Style="{StaticResource StandardButton}" Margin="8,0,0,0" Click="Clear_Click" />
            <TextBlock x:Name="CountText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <ItemsControl x:Name="Tiles">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <!-- Collapse the generated container, not just its content, so filtered-out tiles leave no gap. -->
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:ReciterSurahTile}">
                    <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,8,8" Cursor="Hand" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  IsEnabled="{Binding IsSelectable}" Opacity="{Binding TileOpacity}"
                                  ToolTip="{Binding StateText}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Height="56" CornerRadius="6" Padding="14,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource NavSelectedBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Number}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                                            <TextBlock Text="{Binding NameSimple}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontFamily="{StaticResource UiFont}" FontSize="12" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- A surah this recording has audio for but no timings: it plays, the panel holds still. -->
                                            <TextBlock Text="&#xE8D8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource TextDisabledBrush}"
                                                       ToolTip="{s:Loc recitation.timing.none}"
                                                       Visibility="{Binding IsUntimed, Converter={StaticResource BoolToVisibility}}" />
                                            <TextBlock Text="{Binding StateGlyph}" Style="{StaticResource Icon}" FontSize="13" Foreground="{Binding StateBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
