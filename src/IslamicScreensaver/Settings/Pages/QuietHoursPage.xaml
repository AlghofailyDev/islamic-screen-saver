<UserControl x:Class="IslamicScreensaver.Settings.Pages.QuietHoursPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IslamicScreensaver.Settings.Controls"
             xmlns:s="clr-namespace:IslamicScreensaver.Settings">
    <StackPanel MinWidth="740" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="{s:Loc quiet.title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{s:Loc quiet.subtitle}" Style="{StaticResource PageSubtitle}" />

        <c:SettingsCard Header="{s:Loc quiet.enable}" Description="{s:Loc quiet.enable.desc}" Margin="0,20,0,4">
            <ToggleButton x:Name="Enabled" Style="{StaticResource ToggleSwitch}" Click="Enabled_Click" />
        </c:SettingsCard>

        <StackPanel x:Name="Details">
            <c:SettingsCard Header="{s:Loc quiet.from}">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="FromHour" Width="72" Height="32" SelectionChanged="Time_Changed" />
                    <TextBlock Text=":" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="6,0" />
                    <ComboBox x:Name="FromMinute" Width="72" Height="32" SelectionChanged="Time_Changed" />
                </StackPanel>
            </c:SettingsCard>
            <c:SettingsCard Header="{s:Loc quiet.to}">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="ToHour" Width="72" Height="32" SelectionChanged="Time_Changed" />
                    <TextBlock Text=":" Style="{StaticResource Body}" VerticalAlignment="Center" Margin="6,0" />
                    <ComboBox x:Name="ToMinute" Width="72" Height="32" SelectionChanged="Time_Changed" />
                </StackPanel>
            </c:SettingsCard>

            <c:SettingsCard Header="{s:Loc quiet.during}" Description="{s:Loc quiet.during.desc}">
                <ComboBox x:Name="Behaviour" Width="240" Height="32" SelectionChanged="Behaviour_Changed" />
            </c:SettingsCard>
            <TextBlock x:Name="BehaviourNote" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,14" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="WindowText" Style="{StaticResource Body}" />
                    <TextBlock x:Name="NowText" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    <TextBlock x:Name="WarningText" Style="{StaticResource Caption}" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <TextBlock Text="{s:Loc quiet.testNote}" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
