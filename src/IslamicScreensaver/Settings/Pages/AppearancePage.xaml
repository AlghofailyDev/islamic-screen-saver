<UserControl x:Class="IslamicScreensaver.Settings.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IslamicScreensaver.Settings.Controls"
             xmlns:s="clr-namespace:IslamicScreensaver.Settings"
             xmlns:r="clr-namespace:IslamicScreensaver.Rendering"
             xmlns:sv="clr-namespace:IslamicScreensaver.Screensaver">
    <StackPanel MinWidth="740" MaxWidth="820" HorizontalAlignment="Left">
        <Grid>
            <StackPanel>
                <TextBlock Text="{s:Loc appearance.title}" Style="{StaticResource PageTitle}" />
                <TextBlock Text="{s:Loc appearance.subtitle}" Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Content="{s:Loc appearance.resetDefaults}" Style="{StaticResource StandardButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Reset_Click" />
        </Grid>

        <!-- Live preview: the real background and verse panel, scaled from the 1920×1080 design canvas. -->
        <Border Margin="0,20,0,0" CornerRadius="8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ClipToBounds="True" Background="Black">
            <Grid>
                <Viewbox Stretch="Uniform">
                    <Grid Width="1920" Height="1080">
                        <r:BackgroundLayer x:Name="PreviewBackground" />
                        <Grid>
                            <sv:VersePanel x:Name="PreviewPanel" />
                        </Grid>
                    </Grid>
                </Viewbox>
                <TextBlock Text="{s:Loc appearance.preview}" FontSize="11" Foreground="#8CFFFFFF" Margin="14,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <TextBlock Text="{s:Loc appearance.panel}" Style="{StaticResource SectionTitle}" />
        <c:SettingsCard Header="{s:Loc appearance.position}" Description="{s:Loc appearance.position.desc}">
            <ComboBox x:Name="PanelPositionBox" Width="200" Height="32" SelectionChanged="PanelPosition_Changed" />
        </c:SettingsCard>
        <c:SettingsCard Header="{s:Loc appearance.blur}" Description="{s:Loc appearance.blur.desc}">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="Blur" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="60" ValueChanged="Blur_Changed" />
                <TextBlock x:Name="BlurValue" Style="{StaticResource SliderValue}" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="{s:Loc appearance.grain}" Description="{s:Loc appearance.grain.desc}">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="Grain" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" ValueChanged="Grain_Changed" />
                <TextBlock x:Name="GrainValue" Style="{StaticResource SliderValue}" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="{s:Loc appearance.tint}" Description="{s:Loc appearance.tint.desc}">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="TintMode" Width="140" Height="32" SelectionChanged="TintMode_Changed" />
                <TextBox x:Name="TintHex" Style="{StaticResource HexBox}" Margin="12,0,0,0" TextChanged="TintHex_Changed" />
                <Border x:Name="TintSwatch" Width="32" Height="32" CornerRadius="4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="8,0,0,0" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="{s:Loc appearance.opacity}" Description="{s:Loc appearance.opacity.desc}">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="TintOpacity" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" ValueChanged="TintOpacity_Changed" />
                <TextBlock x:Name="TintOpacityValue" Style="{StaticResource SliderValue}" />
            </StackPanel>
        </c:SettingsCard>

        <TextBlock Text="{s:Loc appearance.text}" Style="{StaticResource SectionTitle}" />
        <c:SettingsCard Header="{s:Loc appearance.arabicColour}">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="ArabicHex" Style="{StaticResource HexBox}" TextChanged="ArabicHex_Changed" />
                <Border x:Name="ArabicSwatch" Width="32" Height="32" CornerRadius="4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="8,0,0,0" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="{s:Loc appearance.translationColour}">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TranslationHex" Style="{StaticResource HexBox}" TextChanged="TranslationHex_Changed" />
                <Border x:Name="TranslationSwatch" Width="32" Height="32" CornerRadius="4" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="8,0,0,0" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="{s:Loc appearance.wordHighlight}" Description="{s:Loc appearance.wordHighlight.desc}">
            <ToggleButton x:Name="WordHighlight" Style="{StaticResource ToggleSwitch}" Click="WordHighlight_Click" />
        </c:SettingsCard>

        <TextBlock Text="{s:Loc nav.appearance}" Style="{StaticResource SectionTitle}" />
        <c:SettingsCard Header="{s:Loc appearance.theme}" Description="{s:Loc appearance.theme.desc}">
            <ComboBox x:Name="Theme" Width="200" Height="32" SelectionChanged="Theme_Changed" />
        </c:SettingsCard>
        <c:SettingsCard Header="{s:Loc appearance.language}" Description="{s:Loc appearance.language.desc}">
            <ComboBox x:Name="LanguageBox" Width="200" Height="32" SelectionChanged="Language_Changed" />
        </c:SettingsCard>
    </StackPanel>
</UserControl>
