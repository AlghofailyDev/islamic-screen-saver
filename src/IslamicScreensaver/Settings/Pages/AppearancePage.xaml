<UserControl x:Class="IslamicScreensaver.Settings.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IslamicScreensaver.Settings.Controls"
             xmlns:r="clr-namespace:IslamicScreensaver.Rendering"
             xmlns:s="clr-namespace:IslamicScreensaver.Screensaver">
    <StackPanel MinWidth="740" MaxWidth="820" HorizontalAlignment="Left">
        <Grid>
            <StackPanel>
                <TextBlock Text="Appearance" Style="{StaticResource PageTitle}" />
                <TextBlock Text="How the verse panel looks over your background." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button Content="Reset to defaults" Style="{StaticResource StandardButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Reset_Click" />
        </Grid>

        <!-- Live preview: the real background and verse panel, scaled from the 1920×1080 design canvas. -->
        <Border Margin="0,20,0,0" CornerRadius="8" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" ClipToBounds="True" Background="Black">
            <Grid>
                <Viewbox Stretch="Uniform">
                    <Grid Width="1920" Height="1080">
                        <r:BackgroundLayer x:Name="PreviewBackground" />
                        <Grid>
                            <s:VersePanel x:Name="PreviewPanel" />
                        </Grid>
                    </Grid>
                </Viewbox>
                <TextBlock Text="L I V E   P R E V I E W" FontSize="11" Foreground="#8CFFFFFF" Margin="14,12,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Grid>
        </Border>

        <TextBlock Text="Panel" Style="{StaticResource SectionTitle}" />
        <c:SettingsCard Header="Blur strength" Description="How much the background is softened behind the panel">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="Blur" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="60" ValueChanged="Blur_Changed" />
                <TextBlock x:Name="BlurValue" Style="{StaticResource SliderValue}" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="Grain" Description="A fine texture over the glass">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="Grain" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" ValueChanged="Grain_Changed" />
                <TextBlock x:Name="GrainValue" Style="{StaticResource SliderValue}" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="Panel tint" Description="Automatic picks a colour from the background">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="TintMode" Width="140" Height="32" SelectionChanged="TintMode_Changed">
                    <ComboBoxItem Content="Automatic" />
                    <ComboBoxItem Content="Custom" />
                </ComboBox>
                <TextBox x:Name="TintHex" Style="{StaticResource HexBox}" Margin="12,0,0,0" TextChanged="TintHex_Changed" />
                <Border x:Name="TintSwatch" Width="32" Height="32" CornerRadius="4" BorderBrush="#1F000000" BorderThickness="1" Margin="8,0,0,0" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="Panel opacity" Description="How strongly the tint covers the blurred background">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="TintOpacity" Style="{StaticResource SettingSlider}" Minimum="0" Maximum="100" ValueChanged="TintOpacity_Changed" />
                <TextBlock x:Name="TintOpacityValue" Style="{StaticResource SliderValue}" />
            </StackPanel>
        </c:SettingsCard>

        <TextBlock Text="Text" Style="{StaticResource SectionTitle}" />
        <c:SettingsCard Header="Arabic text colour">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="ArabicHex" Style="{StaticResource HexBox}" TextChanged="ArabicHex_Changed" />
                <Border x:Name="ArabicSwatch" Width="32" Height="32" CornerRadius="4" BorderBrush="#1F000000" BorderThickness="1" Margin="8,0,0,0" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="Translation text colour">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="TranslationHex" Style="{StaticResource HexBox}" TextChanged="TranslationHex_Changed" />
                <Border x:Name="TranslationSwatch" Width="32" Height="32" CornerRadius="4" BorderBrush="#1F000000" BorderThickness="1" Margin="8,0,0,0" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="Word highlight" Description="Light up the word being recited">
            <ToggleButton x:Name="WordHighlight" Style="{StaticResource ToggleSwitch}" Click="WordHighlight_Click" />
        </c:SettingsCard>
    </StackPanel>
</UserControl>
