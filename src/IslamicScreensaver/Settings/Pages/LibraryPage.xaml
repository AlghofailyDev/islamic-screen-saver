<UserControl x:Class="IslamicScreensaver.Settings.Pages.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IslamicScreensaver.Settings.Controls"
             xmlns:s="clr-namespace:IslamicScreensaver.Settings"
             xmlns:pages="clr-namespace:IslamicScreensaver.Settings.Pages">
    <StackPanel MinWidth="740" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="{s:Loc library.title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{s:Loc library.subtitle}" Style="{StaticResource PageSubtitle}" />

        <c:SettingsCard Header="{s:Loc library.rotate}" Description="{s:Loc library.rotate.desc}" Margin="0,20,0,4">
            <ToggleButton x:Name="Rotate" Style="{StaticResource ToggleSwitch}" Click="Rotate_Click" />
        </c:SettingsCard>

        <Grid Margin="0,16,0,8">
            <TextBlock x:Name="SummaryText" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
            <Button Content="{s:Loc library.add}" Style="{StaticResource StandardButton}" HorizontalAlignment="Right" Click="AddReciter_Click" />
        </Grid>

        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:LibraryRow}">
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,0" MinHeight="64" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Row_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="Include in playback" />

                                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" Background="{Binding AvatarBrush}" Margin="16,0,0,0">
                                    <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding AvatarForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,10,16,10">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Body}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,16,0" />

                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding PlayGlyph}" Style="{StaticResource IconButton}" Command="{Binding PlayCommand}" ToolTip="Listen" Margin="0,0,8,0" />
                                    <Button Content="&#xE74D;" Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}" ToolTip="Delete this reciter's downloads" Margin="0,0,8,0" />
                                    <Button Content="&#xE76C;" Style="{StaticResource IconButton}" Command="{Binding OpenCommand}" ToolTip="Manage surahs" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border x:Name="EmptyState" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{s:Loc library.empty}" Style="{StaticResource Body}" HorizontalAlignment="Center" />
                <TextBlock Text="{s:Loc library.empty.desc}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,12" />
                <Button Content="{s:Loc library.browse}" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Click="AddReciter_Click" />
            </StackPanel>
        </Border>

        <TextBlock Text="{s:Loc library.storage}" Style="{StaticResource SectionTitle}" />
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{s:Loc library.location}" Style="{StaticResource Body}" />
                        <TextBlock x:Name="LocationText" Style="{StaticResource PathText}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{s:Loc common.open}" Style="{StaticResource StandardButton}" Margin="0,0,8,0" Click="OpenFolder_Click" />
                        <Button x:Name="ResetLocationButton" Content="{s:Loc common.reset}" Style="{StaticResource StandardButton}" Margin="0,0,8,0" Click="ResetLocation_Click" ToolTip="Move back to the default folder" />
                        <Button x:Name="ChangeLocationButton" Content="{s:Loc common.change}" Style="{StaticResource StandardButton}" Click="ChangeLocation_Click" />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="MovePanel" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock x:Name="MoveText" Style="{StaticResource Caption}" />
                    <ProgressBar x:Name="MoveProgress" Maximum="1" Height="3" Margin="0,6,0,0" BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
