<UserControl x:Class="IslamicScreensaver.Settings.Pages.ReciterDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:IslamicScreensaver.Settings"
             xmlns:pages="clr-namespace:IslamicScreensaver.Settings.Pages">
    <StackPanel MinWidth="740" MaxWidth="820" HorizontalAlignment="Left">

        <Button Style="{StaticResource StandardButton}" HorizontalAlignment="Left" BorderThickness="0" Background="Transparent" Padding="4,0,10,0" Click="Back_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72B;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0" />
                <TextBlock Text="{s:Loc reciters.title}" Style="{StaticResource Body}" />
            </StackPanel>
        </Button>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                <TextBlock x:Name="Initials" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Title" Style="{StaticResource PageTitle}" />
                <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}" Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{s:Loc recitation.choose}" Style="{StaticResource Caption}" Margin="0,22,0,8" />

        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8">
            <ItemsControl x:Name="List">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type pages:RecitationRow}">
                        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,0" MinHeight="72" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" ToolTip="{s:Loc recitation.playing}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,12,16,12">
                                    <TextBlock Text="{Binding Riwayah}" Style="{StaticResource Body}" FlowDirection="{Binding TextDirection}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Style}" Style="{StaticResource Caption}" FlowDirection="{Binding TextDirection}" Margin="0,0,10,0"
                                                   Visibility="{Binding HasStyle, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding TimingText}" Style="{StaticResource Caption}" Foreground="{Binding TimingBrush}" Margin="0,0,10,0" />
                                        <TextBlock Text="{Binding SourceName}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextDisabledBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="150" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,6,0"
                                                   Visibility="{Binding HasDownloads, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3" Margin="0,6,0,0" BorderThickness="0"
                                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>

                                <Button Grid.Column="3" Content="{s:Loc recitation.chooseSurahs}" Style="{StaticResource StandardButton}" VerticalAlignment="Center"
                                        Command="{Binding OpenCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <TextBlock x:Name="Hint" Style="{StaticResource Caption}" Margin="0,12,0,0" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
