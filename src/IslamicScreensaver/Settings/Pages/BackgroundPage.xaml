<UserControl x:Class="IslamicScreensaver.Settings.Pages.BackgroundPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IslamicScreensaver.Settings.Controls"
             xmlns:s="clr-namespace:IslamicScreensaver.Settings"
             xmlns:r="clr-namespace:IslamicScreensaver.Rendering">
    <UserControl.Resources>
        <Style x:Key="Thumb" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Width="248" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Padding="2" Background="{DynamicResource CardBackgroundBrush}">
                            <StackPanel>
                                <Border CornerRadius="6" ClipToBounds="True" Height="136">
                                    <ContentPresenter />
                                </Border>
                                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Body}" Margin="8,8,8,6" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel MinWidth="740" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="{s:Loc background.title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{s:Loc background.subtitle}" Style="{StaticResource PageSubtitle}" />

        <TextBlock Text="{s:Loc background.bundled}" Style="{StaticResource SectionTitle}" />
        <WrapPanel>
            <RadioButton x:Name="DawnThumb" Style="{StaticResource Thumb}" Tag="{s:Loc background.dawn}" GroupName="bg" Click="Bundled_Click">
                <Viewbox Stretch="UniformToFill"><Grid Width="480" Height="270"><r:BackgroundLayer x:Name="DawnPreview" /></Grid></Viewbox>
            </RadioButton>
            <RadioButton x:Name="NightThumb" Style="{StaticResource Thumb}" Tag="{s:Loc background.night}" GroupName="bg" Click="Bundled_Click">
                <Viewbox Stretch="UniformToFill"><Grid Width="480" Height="270"><r:BackgroundLayer x:Name="NightPreview" /></Grid></Viewbox>
            </RadioButton>
        </WrapPanel>

        <TextBlock Text="{s:Loc background.yourOwn}" Style="{StaticResource SectionTitle}" />
        <WrapPanel>
            <RadioButton x:Name="FileThumb" Style="{StaticResource Thumb}" Tag="{s:Loc background.photoOrVideo}" GroupName="bg" Click="File_Click">
                <Grid Background="#0D000000">
                    <Viewbox Stretch="UniformToFill"><Grid Width="480" Height="270"><r:BackgroundLayer x:Name="FilePreview" /></Grid></Viewbox>
                    <TextBlock x:Name="FileHint" Text="{s:Loc background.noFile}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </RadioButton>
            <StackPanel VerticalAlignment="Top" Margin="8,4,0,0">
                <Button Content="{s:Loc common.choose}" Style="{StaticResource StandardButton}" HorizontalAlignment="Left" Click="Choose_Click" />
                <TextBlock x:Name="FilePath" Style="{StaticResource PathText}" Margin="0,10,0,0" MaxWidth="380" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <TextBlock Text="{s:Loc background.fileTypes}" Style="{StaticResource Caption}" Margin="0,6,0,0" MaxWidth="380" />
            </StackPanel>
        </WrapPanel>

        <TextBlock Text="{s:Loc background.monitors}" Style="{StaticResource SectionTitle}" />
        <c:SettingsCard Header="{s:Loc background.mirror}" Description="{s:Loc background.mirror.desc}">
            <ToggleButton x:Name="Mirror" Style="{StaticResource ToggleSwitch}" Click="Mirror_Click" />
        </c:SettingsCard>
    </StackPanel>
</UserControl>
