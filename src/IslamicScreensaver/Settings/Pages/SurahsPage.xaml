<UserControl x:Class="IslamicScreensaver.Settings.Pages.SurahsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IslamicScreensaver.Settings.Controls"
             xmlns:s="clr-namespace:IslamicScreensaver.Settings"
             xmlns:pages="clr-namespace:IslamicScreensaver.Settings.Pages">
    <StackPanel MinWidth="740" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="{s:Loc surahs.title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{s:Loc surahs.subtitle}" Style="{StaticResource PageSubtitle}" />

        <c:SettingsCard Header="{s:Loc surahs.order}" Description="{s:Loc surahs.order.desc}" Margin="0,20,0,4">
            <ComboBox x:Name="Order" Width="150" Height="32" SelectionChanged="Order_Changed" />
        </c:SettingsCard>
        <c:SettingsCard Header="{s:Loc surahs.resume}" Description="{s:Loc surahs.resume.desc}">
            <ToggleButton x:Name="Resume" Style="{StaticResource ToggleSwitch}" Click="Resume_Click" />
        </c:SettingsCard>

        <Grid Margin="0,20,0,10">
            <StackPanel Orientation="Horizontal">
                <Border Width="240" Height="32" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="10,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                        <TextBox x:Name="Search" Background="Transparent" BorderThickness="0" Padding="30,0,8,0" VerticalContentAlignment="Center" FontSize="14" TextChanged="Search_Changed" />
                        <TextBlock x:Name="SearchHint" Text="{s:Loc reciters.searchSurahs}" Style="{StaticResource Body}" Foreground="{DynamicResource TextDisabledBrush}" Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                </Border>
                <Button Content="{s:Loc common.selectAll}" Style="{StaticResource StandardButton}" Margin="12,0,0,0" Click="SelectAll_Click" />
                <Button Content="{s:Loc common.clear}" Style="{StaticResource StandardButton}" Margin="8,0,0,0" Click="Clear_Click" />
                <TextBlock x:Name="CountText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </Grid>

        <ItemsControl x:Name="Tiles">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <!-- Collapse the generated container, not just its content, so filtered-out tiles leave no gap. -->
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type pages:SurahTile}">
                    <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,8,8" Cursor="Hand" Focusable="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" Height="56" CornerRadius="6" Padding="14,0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource NavSelectedBrush}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Number}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                                            <TextBlock Text="{Binding NameSimple}" Style="{StaticResource Body}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock Text="{Binding Meta}" Style="{StaticResource Caption}" TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding NameArabic}" FontFamily="Traditional Arabic, Arabic Typesetting" FontSize="20" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <TextBlock x:Name="Check" Grid.Column="3" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Visibility="Hidden" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="EmptyText" Text="The surah list has not been fetched yet — connect to the internet and use Refresh list on the Reciters page." Style="{StaticResource Caption}" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
