<UserControl x:Class="IslamicScreensaver.Settings.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:IslamicScreensaver.Settings.Controls"
             xmlns:s="clr-namespace:IslamicScreensaver.Settings">
    <StackPanel MinWidth="740" MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="{s:Loc about.title}" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="VersionText" Style="{StaticResource PageSubtitle}" />

        <TextBlock Text="{s:Loc about.content}" Style="{StaticResource SectionTitle}" />
        <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16">
            <StackPanel>
                <TextBlock Style="{StaticResource Body}">
                    Recitations, verse timings, Uthmani text and translations are provided by
                    <Hyperlink NavigateUri="https://quran.com" RequestNavigate="Link_RequestNavigate">Quran.com</Hyperlink>
                    through its public API. Each translation remains the work of its named translator or publisher.
                </TextBlock>
                <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0">
                    Audio playback uses <Hyperlink NavigateUri="https://github.com/naudio/NAudio" RequestNavigate="Link_RequestNavigate">NAudio</Hyperlink> (MIT).
                    The Arabic typeface is Windows' own unless a Quran font such as KFGQPC Uthmanic Hafs is placed in the app's assets\fonts folder.
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Text="{s:Loc about.storage}" Style="{StaticResource SectionTitle}" />
        <c:SettingsCard Header="{s:Loc about.downloadedContent}" x:Name="CacheCard">
            <StackPanel Orientation="Horizontal">
                <Button Content="{s:Loc common.openFolder}" Style="{StaticResource StandardButton}" Click="OpenCache_Click" />
                <Button Content="{s:Loc about.clearCache}" Style="{StaticResource StandardButton}" Margin="8,0,0,0" Click="ClearCache_Click" />
            </StackPanel>
        </c:SettingsCard>
        <c:SettingsCard Header="{s:Loc about.settingsFile}" x:Name="SettingsCard">
            <Button Content="{s:Loc common.openFolder}" Style="{StaticResource StandardButton}" Click="OpenSettings_Click" />
        </c:SettingsCard>
        <c:SettingsCard Header="{s:Loc about.logs}" Description="{s:Loc about.logs.desc}">
            <Button Content="{s:Loc common.openFolder}" Style="{StaticResource StandardButton}" Click="OpenLogs_Click" />
        </c:SettingsCard>
    </StackPanel>
</UserControl>
