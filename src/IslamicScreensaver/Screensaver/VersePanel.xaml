<UserControl x:Class="IslamicScreensaver.Screensaver.VersePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:r="clr-namespace:IslamicScreensaver.Rendering"
             HorizontalAlignment="Center"
             VerticalAlignment="Bottom"
             Margin="0,0,0,88"
             Width="1040">
    <UserControl.Resources>
        <Style x:Key="ArabicStyle" TargetType="TextBlock">
            <Setter Property="FlowDirection" Value="RightToLeft" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="66" />
            <Setter Property="LineHeight" Value="125" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Foreground" Value="#FBF5E6" />
        </Style>
        <Style x:Key="TranslationStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="LineHeight" Value="33" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Foreground" Value="#BDFFFFFF" />
            <Setter Property="Margin" Value="0,18,0,0" />
        </Style>
    </UserControl.Resources>

    <!-- Sizes are the 1080p design values; the window scales the whole overlay by monitor height. -->
    <StackPanel>

        <!-- Surah chip -->
        <r:GlassPanel x:Name="Chip"
                      HorizontalAlignment="Center"
                      CornerRadius="999"
                      BlurRadius="12"
                      Grain="0"
                      TintColor="#000000"
                      TintOpacity="0.28"
                      Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" Margin="18,8">
                <TextBlock x:Name="ChipArabic" FontSize="24" Foreground="#D9FFFFFF" VerticalAlignment="Center" FlowDirection="RightToLeft" Margin="0,-4,0,-2" />
                <Rectangle Width="1" Height="14" Fill="#40FFFFFF" Margin="14,0" VerticalAlignment="Center" />
                <!-- The juz', named the way a mushaf names it: جزء عمّ rather than a bare number. -->
                <TextBlock x:Name="ChipJuz" FontSize="14" Foreground="#D9FFFFFF" VerticalAlignment="Center" />
                <Rectangle x:Name="ChipSeparator2" Width="1" Height="14" Fill="#40FFFFFF" Margin="14,0" VerticalAlignment="Center" />
                <TextBlock x:Name="ChipVerse" FontSize="14" Foreground="#A6FFFFFF" VerticalAlignment="Center" />
            </StackPanel>
        </r:GlassPanel>

        <!-- Verse card -->
        <r:GlassPanel x:Name="Glass" CornerRadius="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Two layers in the same cell so a verse change can crossfade. -->
                <Grid Grid.Row="0" Margin="64,52,64,48">
                    <StackPanel x:Name="LayerA" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                        <TextBlock x:Name="ArabicA" Style="{StaticResource ArabicStyle}" />
                        <TextBlock x:Name="TranslationA" Style="{StaticResource TranslationStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="LayerB" RenderTransformOrigin="0.5,0.5" Opacity="0" Visibility="Collapsed">
                        <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
                        <TextBlock x:Name="ArabicB" Style="{StaticResource ArabicStyle}" />
                        <TextBlock x:Name="TranslationB" Style="{StaticResource TranslationStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Progress hairline -->
                <Grid x:Name="ProgressTrack" Grid.Row="1" Height="2" Margin="64,0,64,0" Background="#24FFFFFF">
                    <Rectangle x:Name="ProgressFill" HorizontalAlignment="Left" Fill="#B3FFFFFF" Width="0" />
                </Grid>
            </Grid>
        </r:GlassPanel>
    </StackPanel>
</UserControl>
