<Window x:Class="IslamicScreensaver.Screensaver.ScreensaverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IslamicScreensaver.Screensaver"
        xmlns:r="clr-namespace:IslamicScreensaver.Rendering"
        Title="Islamic Screensaver"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Black"
        Cursor="None"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">
    <Grid x:Name="Root" Background="Black">
        <r:BackgroundLayer x:Name="Backdrop" />

        <!-- Everything drawn over the background is designed at 1080p and scaled to the monitor's height. -->
        <Grid x:Name="Overlay">
            <local:VersePanel x:Name="Panel" />

            <StackPanel x:Name="ReciterBlock"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="48,0,0,40"
                        Visibility="Collapsed">
                <TextBlock x:Name="ReciterCaption"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="11"
                           Foreground="#73FFFFFF" />
                <TextBlock x:Name="ReciterName"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="15"
                           Foreground="#B8FFFFFF"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
