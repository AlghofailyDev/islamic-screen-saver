<UserControl x:Class="IslamicScreensaver.Screensaver.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Placeholder until M4 provides a real still of the screensaver. -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0D2A36" Offset="0" />
                <GradientStop Color="#1A4A57" Offset="0.4" />
                <GradientStop Color="#7A7A6A" Offset="0.7" />
                <GradientStop Color="#D9A56A" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>
        <Border VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                Margin="0,0,0,10"
                Padding="10,5"
                CornerRadius="5"
                BorderThickness="1"
                BorderBrush="#24FFFFFF"
                Background="#6A0F2A2E">
            <TextBlock Text="بِسْمِ ٱللَّهِ"
                       FlowDirection="RightToLeft"
                       FontFamily="Traditional Arabic"
                       FontSize="14"
                       Foreground="#FBF5E6" />
        </Border>
    </Grid>
</UserControl>
